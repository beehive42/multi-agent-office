# ─────────────────────────────────────────────
# 运行时依赖 / 运行时环境（体积大，可重新安装生成）
# ─────────────────────────────────────────────
tools/
.venv/
.home/
.tmp-openclaw/

# ─────────────────────────────────────────────
# 运行时状态、缓存、日志
# ─────────────────────────────────────────────
.openclaw/
logs/
logs/**/*.log
*.log

# 归档目录里的历史日志是记录的一部分，保留
!归档/日志/
!归档/日志/*
cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# openclaw 各 agent 工作区（内部各自带 .git，属于运行期产物）
openclaw-workspace/agents/
openclaw-workspace/hello-agent/

# 运行期状态与输出
office-collab/state/

# ─────────────────────────────────────────────
# 密钥与本地配置（切勿提交）
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*api-key*.txt
*api_key*.txt
*token*.txt
config-journal-fingerprint.key
.claude/
.dsh/

# ─────────────────────────────────────────────
# 系统 / 编辑器 / 临时文件
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
*.tmp
*.bak
